{
  "name": "daily-quotes-ai",
  "displayName": "Daily Quotes AI",
  "description": "A production-grade Chrome extension delivering daily inspirational quotes with AI generation, statistics, streaks, themes, and achievements.",
"version": "1.0.0",
  "author": "Daily Quotes AI",
  "manifest": {
    "permissions": [
      "storage",
      "notifications",
      "alarms",
      "contextMenus",
      "offscreen",
      "commands",
      "clipboardWrite"
    ],
    "host_permissions": [
      "https://api.openai.com/*"
    ],
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Ctrl+Shift+Y",
          "mac": "Command+Shift+Y"
        },
        "description": "Open Daily Quotes AI popup"
      },
      "next_quote": {
        "suggested_key": {
          "default": "Ctrl+Shift+U",
          "mac": "Command+Shift+U"
        },
        "description": "Fetch next quote"
      },
      "favorite_quote": {
        "suggested_key": {
          "default": "Ctrl+Shift+F",
          "mac": "Command+Shift+F"
        },
        "description": "Bookmark current quote as favorite"
      }
    }
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv2",
    "start": "plasmo dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "dependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "framer-motion": "11.2.10",
    "plasmo": "0.86.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.35.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "<rootDir>/tests/styleMock.js",
      "\\.(png|jpg|jpeg|gif|svg)$": "<rootDir>/tests/fileMock.js"
    },
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/tests/**/*.test.[jt]s?(x)"
    ]
  }
}
